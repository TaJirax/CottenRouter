{
  "listen_udp": "0.0.0.0:53",
  "listen_tcp": "0.0.0.0:53",
  "query_timeout_ms": 10000,
  "max_packet_size": 4096,
	"max_tcp_message_size": 65535,
  "max_pending_per_backend": 8192,
  "max_tcp_connections": 256,
  "unmatched_action": "drop",
	"limits": {
		"udp_workers": 32,
		"udp_queue": 4096,
		"global_queries_per_second": 20000,
		"global_query_burst": 40000,
		"per_ip_queries_per_second": 2000,
		"per_ip_query_burst": 4000,
		"max_tracked_ips": 16384,
		"max_tcp_connections_per_ip": 32,
		"max_tcp_queries_per_connection": 1024,
		"max_tcp_inflight_per_connection": 8,
		"response_bytes_per_second": 10485760,
		"response_burst_bytes": 4194304,
		"ingress_bytes_per_second": 10485760,
		"ingress_burst_bytes": 4194304,
		"trusted_resolver_cidrs": []
	},
	"tls_listeners": [
		{
			"name": "dot",
			"listen": "0.0.0.0:853",
			"routes": [
				{"name": "cottendns-dot", "server_names": ["dot.example.com"], "backend": "127.0.0.1:8853"}
			]
		},
		{
			"name": "https",
			"listen": "0.0.0.0:443",
			"routes": [
				{"name": "cottendns-doh", "server_names": ["doh.example.com"], "backend": "127.0.0.1:8443"},
				{"name": "slipgate-naive", "server_names": ["naive.example.com"], "backend": "127.0.0.1:9443"},
				{"name": "slipgate-stuntls", "server_names": ["stun.example.com"], "backend": "127.0.0.1:9444"}
			]
		}
	],
  "routes": [
    {
      "name": "cottendns",
      "domains": ["cotten.example.com"],
      "backend": "127.0.0.1:5301",
      "tcp_backend": "127.0.0.1:5301"
    },
    {
      "name": "masterdnsvpn",
      "domains": ["master.example.com"],
      "backend": "127.0.0.1:5302",
      "tcp_backend": "disabled"
    },
    {
      "name": "stormdns",
      "domains": ["storm.example.com"],
      "backend": "127.0.0.1:5303",
      "tcp_backend": "disabled"
    },
    {
      "name": "thefeed",
      "domains": ["feed.example.com", "chat.example.com"],
      "backend": "127.0.0.1:5304",
      "tcp_backend": "disabled"
    }
  ]
}
